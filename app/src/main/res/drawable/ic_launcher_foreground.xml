<?xml version="1.0" encoding="utf-8"?>
<!-- Two overlapping speech bubbles with text lines: reads as translation/conversation
     between two languages, rather than a generic swap/convert icon. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Back bubble (top-left) -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.55"
        android:pathData="M18,20 H66 V50 H32 L20,64 V50 H18 Z" />

    <!-- Front bubble (bottom-right) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M42,50 H90 V80 H80 L88,92 L70,80 H42 Z" />

    <!-- Text lines inside the front bubble -->
    <path
        android:fillColor="#3D5AFE"
        android:pathData="M50,58 H82 V64 H50 Z" />
    <path
        android:fillColor="#3D5AFE"
        android:pathData="M50,68 H74 V74 H50 Z" />
</vector>
