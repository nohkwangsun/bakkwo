<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Tapping the result opens the app with the full text. No separate header row: dropping it
         frees enough vertical space for the widget to be usable at a much smaller minimum size. -->
    <TextView
        android:id="@+id/widget_result"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:contentDescription="@string/label_result"
        android:ellipsize="end"
        android:gravity="top|start"
        android:lineSpacingExtra="2dp"
        android:maxLines="4"
        android:text="@string/widget_placeholder_result"
        android:textColor="@color/widget_on_surface"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_btn_translate"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_primary"
            android:contentDescription="@string/widget_btn_translate"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_translate_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_translate"
                android:tint="@color/widget_on_primary" />

            <TextView
                android:id="@+id/widget_translate_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/widget_btn_translate"
                android:textColor="@color/widget_on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_btn_copy"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_tonal"
            android:contentDescription="@string/widget_btn_copy">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_copy"
                android:tint="@color/widget_on_tonal" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_btn_reset"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_tonal"
            android:contentDescription="@string/widget_btn_reset">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_refresh"
                android:tint="@color/widget_on_tonal" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
