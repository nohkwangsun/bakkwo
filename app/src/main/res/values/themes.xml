<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Bakkwo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bakkwo_primary</item>
        <item name="colorPrimaryDark">@color/bakkwo_primary_dark</item>
        <item name="colorAccent">@color/bakkwo_primary</item>
        <item name="android:colorBackground">@color/bakkwo_background</item>
        <item name="colorOnPrimary">@color/bakkwo_on_primary</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/bakkwo_primary_dark</item>
    </style>

    <!-- Small floating dialog shown when text is shared into the app from another app. -->
    <style name="Theme.Bakkwo.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog.Alert">
        <item name="colorPrimary">@color/bakkwo_primary</item>
        <item name="colorAccent">@color/bakkwo_primary</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <!-- Fully transparent, used only as a trampoline to gain focus long enough to read the
         clipboard before handing off to WorkManager. Never visible to the user. -->
    <style name="Theme.Bakkwo.Invisible" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>

</resources>
